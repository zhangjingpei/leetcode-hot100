     "2 <= candidates[i] <= 40",
     "candidates 无重复元素",
     "1 <= target <= 40"
    ]
   },
   "solution": {
    "idea": [
     "与子集同款「只向前选」骨架，唯一区别：允许重复 → 递归传 `j` 而不是 `j+1`（本轮选过的还能再选）。",
     "去重靠「起点递增」：组合 [2,2,3] 只会以 2,2,3 的顺序出现，不会出现 [3,2,2]。",
     "剪枝：先把数组排序，若 `candidates[j] > remain` 直接 `break`——后面的数更大，全都不用试了。"
    ],
    "steps": [
     "排序 candidates（便于剪枝）",
     "`dfs(j, remain)`：从下标 j 开始凑 remain",
     "remain == 0 → 收集方案；`candidates[j] > remain` → break 剪枝",
     "选 `candidates[j]` 后递归 `dfs(j, remain - candidates[j])`（注意是 j，可重复）→ 回溯弹出"
    ],
    "complexity": {
     "time": "O(2^target)（上界，实际剪枝后远小于）",
     "space": "O(target)（递归栈深不超过 target/最小值）"
    },
    "code": "class Solution:\n    def combinationSum(self, candidates: List[int], target: int) -> List[List[int]]:\n        candidates.sort()                # 排序便于剪枝\n        res, path = [], []\n\n        def dfs(j, remain):              # 从 candidates[j:] 凑 remain\n            if remain == 0:              # 凑够了，收集方案\n                res.append(path[:])\n                return\n            for k in range(j, len(candidates)):\n                if candidates[k] > remain:   # 剪枝：后面只会更大\n                    break\n                path.append(candidates[k])\n                dfs(k, remain - candidates[k])   # 传 k：允许重复选自己\n                path.pop()\n\n        dfs(0, target)\n        return res"
   },
