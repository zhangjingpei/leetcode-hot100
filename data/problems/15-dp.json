     "time": "O(n × target)",
     "space": "O(target)"
    },
    "code": "class Solution:\n    def canPartition(self, nums: List[int]) -> bool:\n        total = sum(nums)\n        if total % 2:\n            return False\n        target = total // 2\n        dp = [False] * (target + 1)\n        dp[0] = True\n        for num in nums:\n            for c in range(target, num - 1, -1):   # 倒序：0-1 背包不重复\n                dp[c] = dp[c] or dp[c - num]\n            if dp[target]:\n                return True\n        return dp[target]"
   },
